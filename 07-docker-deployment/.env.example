# ==============================================================================
# Конфигурация для FAQ-ассистента
# Скопируй этот файл в .env и заполни своими значениями
# ==============================================================================

# Langfuse (опционально)
# Получи ключи на https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Ollama (обычно не нужно менять)
OLLAMA_HOST=http://ollama:11434

# RAG директория (обычно не нужно менять)
RAG_DIR=/app/rag_artifacts

# Порт API (обычно не нужно менять)
PORT=8000
